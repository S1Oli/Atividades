public class VetorPares {
    public static void main(String[] args) {
        int[] vetor = {7, 2, 6, 3, 8, 10, 9, 5, 4, 1};

        System.out.println("Numeros pares no vetor: ");
        for (int i = 0; i < vetor.length; i++) {
            if (vetor[i] % 2 == 0) {
                
                System.out.print(vetor[i] + " ");
            }
        }
    }
}