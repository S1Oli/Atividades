import class MaiorNota {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        double maior = 0;

        for (int i = 1; i <= 10; i++) {
            System.out.print("Digite a nota do aluno " + i + ": ");
            double nota = sc.nextDouble();
            if (nota > maior) {
                maior = nota;
            }
        }

        System.out.println("A maior nota é: " + maior);
        sc.close();
    }
}